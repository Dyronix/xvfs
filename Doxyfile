# Minimal Doxygen configuration for the xvfs public API. Run `doxygen` from the repository root.
# Output: out/docs/html. Only values that differ from the Doxygen defaults are listed.
PROJECT_NAME           = xvfs
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Wildcard content paths and whole-file reads"
OUTPUT_DIRECTORY       = out/docs
INPUT                  = include/xvfs README.md
USE_MDFILE_AS_MAINPAGE = README.md
FILE_PATTERNS          = *.h
RECURSIVE              = NO
STRIP_FROM_PATH        = include
STRIP_FROM_INC_PATH    = include
FULL_PATH_NAMES        = YES
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_CLASSES     = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
